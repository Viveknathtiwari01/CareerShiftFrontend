# CareerShift Frontend — Production Environment Sample
# Copy to .env.production.local (Vite) on your build/CI server.
# Do NOT commit secrets to version control.

# Backend API base URL (must include /api/v1, no trailing slash)
# Use VITE_API_BASE_URL (preferred). VITE_API_URL is also supported.
VITE_API_BASE_URL=https://careershiftbackend.onrender.com/api/v1
